---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
// Polices auto-hebergees : aucune connexion a Google Fonts avant l'affichage.
import '@fontsource-variable/inter/wght.css';
import '@fontsource/playfair-display/700.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import playfairLatin from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BoutonWhatsApp from '../components/BoutonWhatsApp.astro';
import Visionneuse from '../components/Visionneuse.astro';
import { CONTACT, ECOLE } from '../lib/site';
import { photo } from '../lib/photos';

interface Props {
  titre: string;
  description: string;
  /** Ne mettre a true que sur la page d'accueil (donnees structurees School). */
  accueil?: boolean;
}

const { titre, description, accueil = false } = Astro.props;

const canonique = new URL(Astro.url.pathname, Astro.site).href;

// Image de partage (WhatsApp, Facebook) : la cour interieure, en 1200 x 630.
const banniere = photo('cour-interieure');
const ogImage = banniere
  ? new URL(
      (await getImage({ src: banniere, format: 'jpeg', width: 1200, height: 630, quality: 76 })).src,
      Astro.site,
    ).href
  : undefined;

// Favicon et icone d'accueil derives du logo quand il est fourni.
// Sans logo, on retombe sur l'ecusson de remplacement `public/favicon.svg`.
const logo = photo('logo');
const iconePetite = logo
  ? (await getImage({ src: logo, format: 'png', width: 32, height: 32 })).src
  : undefined;
const iconeMoyenne = logo
  ? (await getImage({ src: logo, format: 'png', width: 192, height: 192 })).src
  : undefined;
const iconeApple = logo
  ? (await getImage({ src: logo, format: 'png', width: 180, height: 180 })).src
  : undefined;

const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: ECOLE.nom,
  alternateName: ECOLE.nomCourt,
  slogan: ECOLE.devise,
  url: Astro.site?.href,
  foundingDate: '2001-10',
  telephone: CONTACT.telephoneAffiche,
  email: CONTACT.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.adresse,
    postOfficeBoxNumber: CONTACT.boitePostale,
    addressLocality: CONTACT.ville,
    addressCountry: 'BF',
  },
  ...(ogImage ? { image: ogImage } : {}),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta name="theme-color" content="#1e6b34" />
    <meta name="robots" content="index, follow" />

    <!-- Sans cesure francaise (certains navigateurs de bureau), le texte justifie
         creuserait de grands blancs sur les colonnes etroites : la classe
         `sans-cesure` le ramene alors a gauche sur petit ecran (voir global.css). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var t = document.createElement('div');
        t.lang = 'fr';
        t.style.cssText = 'position:absolute;visibility:hidden;width:4em;hyphens:auto;-webkit-hyphens:auto';
        t.textContent = 'évangélisation';
        d.appendChild(t);
        var h = t.offsetHeight;
        t.style.hyphens = t.style.webkitHyphens = 'manual';
        var sansCesure = t.offsetHeight === h;
        d.removeChild(t);
        // Les transitions de page remplacent les attributs de <html> : on repose la classe.
        function poser() {
          if (sansCesure) document.documentElement.classList.add('sans-cesure');
        }
        poser();
        document.addEventListener('astro:after-swap', poser);
      })();
    </script>

    <!-- Icones : le blason de l'ecole des qu'il est fourni, sinon l'ecusson de repli -->
    {
      logo ? (
        <>
          <link rel="icon" href={iconePetite} type="image/png" sizes="32x32" />
          <link rel="icon" href={iconeMoyenne} type="image/png" sizes="192x192" />
          <link rel="apple-touch-icon" href={iconeApple} />
        </>
      ) : (
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      )
    }

    <!-- Polices servies par le site lui-meme (plus de detour par Google Fonts,
         qui coutait deux connexions supplementaires sur mobile) -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin />

    <!-- Partage sur WhatsApp et Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ECOLE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`La cour intérieure du ${ECOLE.nom}`} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {accueil && <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />}

    <ClientRouter />
  </head>

  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-vert focus:shadow-lg"
    >
      Aller au contenu
    </a>

    <Nav />

    <main id="contenu">
      <slot />
    </main>

    <Footer />
    <BoutonWhatsApp />
    <Visionneuse />

    <script>
      import { demarrerAnimations } from '../scripts/animations';
      import { activerVisionneuse } from '../scripts/visionneuse';

      activerVisionneuse();

      demarrerAnimations();
      // Les transitions de page d'Astro remplacent le contenu : on relance.
      document.addEventListener('astro:page-load', demarrerAnimations);
    </script>
  </body>
</html>
