---
import Compteur from './Compteur.astro';

interface Props {
  /** Valeur animee. Laisser vide pour un chiffre fixe (ex. une année). */
  valeur?: number;
  decimales?: number;
  suffixe?: string;
  /** Texte affiche tel quel a la place du compteur. */
  texteFixe?: string;
  libelle: string;
  retard?: number;
}

const { valeur, decimales = 0, suffixe = '', texteFixe, libelle, retard } = Astro.props;
---

<div
  class="anim flex flex-col items-center justify-start rounded-xl bg-white/70 px-3 py-6 text-center md:bg-transparent md:px-2"
  data-retard={retard}
>
  <p class="font-serif text-[2rem] leading-none text-vert md:text-[2.75rem]">
    {
      texteFixe ? (
        <span style="font-variant-numeric: tabular-nums">{texteFixe}</span>
      ) : (
        <Compteur valeur={valeur!} decimales={decimales} suffixe={suffixe} />
      )
    }
  </p>
  <p class="mt-3 text-sm leading-snug font-medium text-encre-douce">
    {libelle}
  </p>
</div>
