---
import { CONTACT, ECOLE, FACEBOOK_URL, NAVIGATION, WHATSAPP_URL } from '../lib/site';
import LogoEcole from './LogoEcole.astro';
---

<footer class="bg-vert-fonce text-white/80">
  <div class="conteneur py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr] md:gap-12">
      <!-- Identite -->
      <div>
        <div class="flex items-center gap-3">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 p-1">
            <LogoEcole class="h-9 w-9" loading="lazy" />
          </span>
          <p class="font-serif text-lg leading-tight text-white">{ECOLE.nom}</p>
        </div>
        <p class="mt-4 text-sm tracking-wide text-dore-clair">{ECOLE.devise}</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed">
          École catholique tenue par les Frères de la Sainte Famille, du CP1 à la Terminale,
          au quartier Pissy à Ouagadougou.
        </p>
      </div>

      <!-- Contact -->
      <div>
        <h2 class="font-serif text-base text-white">Nous contacter</h2>
        <!-- Liens hauts de 40 px minimum : confortables au doigt sur mobile. -->
        <ul class="mt-3 space-y-0.5 text-sm">
          <li>
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-[40px] items-center gap-2 transition-colors hover:text-white"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.02.24-3.44-.72-2.91-1.15-4.73-4.17-4.87-4.37-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07 1-2.36.26-.29.57-.36.77-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 .89 2.14.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.14-.3.3-.13.59.17.29.75 1.24 1.61 2.01 1.11.99 2.04 1.3 2.33 1.44.29.15.46.12.63-.07.17-.19.73-.85.93-1.15.19-.29.39-.24.65-.14.27.1 1.69.8 1.98.94.29.15.48.22.55.34.07.13.07.72-.17 1.4Z"
                />
              </svg>
              WhatsApp {CONTACT.telephoneAffiche}
            </a>
          </li>
          <li>
            <a
              href={CONTACT.telephoneLien}
              class="inline-flex min-h-[40px] items-center transition-colors hover:text-white"
            >
              Tél. {CONTACT.telephoneAffiche}
            </a>
          </li>
          <li>
            <a
              href={CONTACT.emailLien}
              class="inline-flex min-h-[40px] items-center break-all transition-colors hover:text-white"
            >
              {CONTACT.email}
            </a>
          </li>
          <li class="pt-3 leading-relaxed">
            {CONTACT.boitePostale}<br />
            {CONTACT.adresse}
          </li>
          {
            FACEBOOK_URL && (
              <li>
                <a
                  href={FACEBOOK_URL}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex min-h-[40px] items-center transition-colors hover:text-white"
                >
                  Page Facebook
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Plan du site -->
      <div>
        <h2 class="font-serif text-base text-white">Le site</h2>
        <ul class="mt-3 space-y-0.5 text-sm">
          {
            NAVIGATION.map((onglet) => (
              <li>
                <a
                  href={onglet.href}
                  class="inline-flex min-h-[40px] items-center transition-colors hover:text-white"
                >
                  {onglet.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-12 border-t border-white/15 pt-6 text-xs text-white/75">
      © 2026 {ECOLE.nom}
    </p>
  </div>
</footer>
