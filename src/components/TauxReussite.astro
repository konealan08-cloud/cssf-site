---
/**
 * Taux de reussite par examen, en compteurs animes.
 * 2 colonnes sur mobile, 4 cote a cote des la tablette.
 * `compact` : version reduite, a la place de la photo d'une carte d'actualite.
 */
import Compteur from './Compteur.astro';

interface Props {
  taux: { examen: string; valeur: number; decimales: number }[];
  compact?: boolean;
}

const { taux, compact = false } = Astro.props;
---

{
  compact ? (
    <div class="grid aspect-[16/10] w-full grid-cols-2 gap-px bg-dore/25">
      {taux.map((ligne) => (
        <div class="flex flex-col items-center justify-center bg-creme px-2 text-center">
          <p class="font-serif text-[1.375rem] leading-none text-vert md:text-2xl">
            <Compteur valeur={ligne.valeur} decimales={ligne.decimales} suffixe={'\u00a0%'} />
          </p>
          <p class="mt-1.5 text-xs font-semibold tracking-[0.12em] text-dore-texte uppercase">
            {ligne.examen}
          </p>
        </div>
      ))}
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {taux.map((ligne, index) => (
        <div
          class="anim flex flex-col items-center rounded-2xl border border-dore/30 bg-creme px-3 py-6 text-center md:py-8"
          data-retard={Math.min(index + 1, 5)}
        >
          <p class="font-serif text-[1.875rem] leading-none text-vert xs:text-[2.125rem] md:text-[2.5rem]">
            <Compteur valeur={ligne.valeur} decimales={ligne.decimales} suffixe={'\u00a0%'} />
          </p>
          <p class="mt-3 text-sm font-semibold tracking-[0.12em] text-dore-texte uppercase">
            {ligne.examen}
          </p>
        </div>
      ))}
    </div>
  )
}
