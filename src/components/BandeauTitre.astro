---
/** Bandeau-titre des pages interieures. */
import { ECOLE } from '../lib/site';

interface Props {
  titre: string;
  intro?: string;
}

const { titre, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-vert-fonce text-white">
  <!-- Motif discret, purement decoratif -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 18% 22%, #ffffff 0, transparent 42%), radial-gradient(circle at 86% 78%, #b8921f 0, transparent 46%)"
  >
  </div>

  <div class="conteneur relative py-12 md:py-20">
    <p class="monte monte-1 text-xs font-semibold tracking-[0.18em] text-dore-clair uppercase">
      {ECOLE.nom}
    </p>
    <h1 class="monte monte-2 mt-3 text-[1.875rem] leading-tight md:text-[3rem]">{titre}</h1>
    {
      intro && (
        <p class="monte monte-3 mt-5 max-w-2xl text-base leading-relaxed text-white/80 md:text-lg">
          {intro}
        </p>
      )
    }
  </div>
</section>
